{
  "name": "universal-api-framework",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone local-only API smoke test scaffold",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.performance.json && tsc -p tsconfig.k6.json",
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 --test-reporter=spec dist/tests/*.test.js",
    "perf:install-k6": "node performance/install-k6.ts",
    "perf:smoke": "node performance/run.ts --profile direct-mock --workload smoke --fixture passing",
    "perf:fixture-fail": "node performance/run.ts --profile direct-mock --workload smoke --fixture failing",
    "perf:baseline": "node performance/run.ts --profile direct-mock --workload baseline --fixture passing",
    "perf:dev": "node performance/run.ts --profile dev --workload dev-smoke",
    "test:performance": "node --test --test-concurrency=1 --test-reporter=spec tests/performance/*.test.ts",
    "perf:dev:fixture-fail": "node performance/run.ts --profile dev --workload dev-smoke --fixture failing",
    "perf:dev:baseline": "node performance/run.ts --profile dev --workload dev-baseline"
  },
  "devDependencies": {
    "@types/k6": "0.54.2",
    "@types/node": "22.19.0",
    "openapi-types": "12.1.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@apidevtools/openapi-schemas": "2.1.0",
    "@apidevtools/swagger-parser": "13.0.0",
    "ajv-draft-04": "1.0.0",
    "yaml": "2.9.1"
  }
}
