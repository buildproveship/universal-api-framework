{
  "schemaVersion": 1,
  "hardLimits": {
    "maxVus": 2,
    "maxRatePerSecond": 2,
    "maxDurationSeconds": 10,
    "maxRequestTimeoutMilliseconds": 1000,
    "maxRequestCount": 20
  },
  "profiles": {
    "direct-mock": {
      "enabled": true,
      "environment": "direct-mock",
      "label": "Direct mock-only local synthetic fixture",
      "targetProtocol": "http:",
      "targetHostAllowlist": ["127.0.0.1"],
      "targetPort": "ephemeral-owned-fixture",
      "mockBoundaries": "Harness-owned synthetic API only; no Platform WireMock, Dev application, external integrations, or customer data.",
      "workloads": ["smoke", "baseline"]
    },
    "dev": {
      "enabled": true,
      "environment": "dev",
      "label": "Owned Platform Dev application with actual shared WireMock mappings",
      "targetProtocol": "http:",
      "targetHostAllowlist": ["127.0.0.1"],
      "targetPort": "ephemeral-owned-platform",
      "workloads": ["dev-smoke", "dev-baseline"],
      "mockBoundaries": "Real pinned Platform API with actual pinned WireMock and unchanged shared mappings; isolated disposable synthetic stores and internal application network. No live providers or customer data. Dev results do not prove UAT or Production capacity."
    }
  },
  "workloads": {
    "smoke": {
      "ratePerSecond": 1,
      "durationSeconds": 2,
      "vus": 1,
      "requestTimeoutMilliseconds": 1000,
      "maxRequests": 2
    },
    "baseline": {
      "ratePerSecond": 2,
      "durationSeconds": 10,
      "vus": 2,
      "requestTimeoutMilliseconds": 1000,
      "maxRequests": 20
    },
    "dev-smoke": {
      "ratePerSecond": 1,
      "durationSeconds": 2,
      "vus": 1,
      "requestTimeoutMilliseconds": 1000,
      "maxRequests": 4
    },
    "dev-baseline": {
      "ratePerSecond": 2,
      "durationSeconds": 9,
      "vus": 2,
      "requestTimeoutMilliseconds": 1000,
      "maxRequests": 20
    }
  }
}
